# Dependencies
node_modules/
*/node_modules/

# Build output (regenerated by `npm run build`; published via the gh-pages
# branch / Actions, so it must not live in the source tree).
# NOTE: 404.html is kept tracked — it is the SPA fallback GitHub Pages serves.
/dist/
/assets/
/CNAME

# AI/agent context — kept locally so assistants understand the project,
# but not published to GitHub.
/AGENTS.md
/base.md

# Local-only dev docs and utility scripts (kept on disk, not published).
/docs/
/scripts/

# Backend local build/runtime output
backend/bin/
backend/media/
backend/.gocache/
backend/*.log

# Backups and local data exports
backups/
*.dump
*.backup
*.jsonl

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
vite*.log

# Environment variables
.env
.env.*
!.env.example
!.env.production.example
!backend/.env.example

# Coverage/cache
coverage/
.nyc_output/
.vite/
*.test
*.prof

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/
