# Reverse proxy with automatic HTTPS (Let's Encrypt) for the API.
# API_DOMAIN is injected from the environment (e.g. 77.91.95.18.sslip.io).
{$API_DOMAIN} {
	encode zstd gzip

	# Security response headers applied to every API response.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Cross-Origin-Resource-Policy "cross-origin"
		# Don't advertise the server software.
		-Server
	}

	# Cache media for an hour, but with explicit semantics so response-header
	# changes propagate instead of getting stuck in browsers' heuristic cache
	# (which previously masked the CORP fix and kept videos blocked).
	header /media/* Cache-Control "public, max-age=3600"

	# Mini-game bundles are meant to be embedded in our own app's iframe. The
	# blanket X-Frame-Options: DENY above would block that, so drop it for the
	# games-static path and let the backend's CSP frame-ancestors govern framing.
	header /games-static/* -X-Frame-Options

	# Proxy everything to the Go backend on the internal compose network.
	reverse_proxy backend:8080

	# Cap request body size to match the backend's MAX_REQUEST_BYTES (64 MiB).
	request_body {
		max_size 64MB
	}

	log {
		output stdout
		format console
	}
}

# Friendly domain for the same API (DNS A record -> this server). Caddy
# auto-provisions a Let's Encrypt cert. The sslip.io host above is kept so
# existing media URLs stored in the DB keep resolving.
ado.404.mn {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Cross-Origin-Resource-Policy "cross-origin"
		-Server
	}

	header /media/* Cache-Control "public, max-age=3600"

	# See the games-static note above: allow our own app to frame game bundles.
	header /games-static/* -X-Frame-Options

	reverse_proxy backend:8080

	request_body {
		max_size 64MB
	}

	log {
		output stdout
		format console
	}
}
