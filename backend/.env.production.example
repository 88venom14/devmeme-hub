# Copy to .env.production on the server and fill in real values.
# Used by: docker compose -f docker-compose.prod.yml --env-file .env.production up -d

# --- PostgreSQL container ---
POSTGRES_DB=devmeme_hub
POSTGRES_USER=devmeme
# REQUIRED: strong unique password, e.g. `openssl rand -base64 24`
POSTGRES_PASSWORD=change-me-strong-db-password

# --- Caddy / HTTPS ---
# Public hostname the API is served on. Caddy gets a Let's Encrypt cert for it.
# Using sslip.io maps the server IP to a hostname with no DNS changes needed.
API_DOMAIN=77.91.95.18.sslip.io

# --- Backend container ---
# REQUIRED: unique random secret, at least 32 chars, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-unique-random-secret-at-least-32-chars

ACCESS_TOKEN_TTL=24h

# Comma-separated list of allowed CORS origins (your frontend URLs).
ALLOWED_ORIGINS=https://fluttershy.horsefucker.ru

MAX_REQUEST_BYTES=67108864
MAX_UPLOAD_BYTES=52428800
