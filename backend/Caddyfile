# Reverse proxy with automatic HTTPS (Let's Encrypt) for the API.
# API_DOMAIN is injected from the environment (e.g. 77.91.95.18.sslip.io).
{$API_DOMAIN} {
	encode zstd gzip

	# Everything except user-game bundles. A global header set + a path-scoped
	# delete don't compose reliably in Caddy, so X-Frame-Options is applied via
	# this negative matcher instead.
	@notgames not path /games-static/*

	# Security response headers applied to every API response.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Cross-Origin-Resource-Policy "cross-origin"
		# Don't advertise the server software.
		-Server
	}

	# X-Frame-Options: DENY everywhere EXCEPT mini-game bundles, which our own
	# app must be able to embed in its sandboxed iframe (the backend's CSP
	# frame-ancestors governs who may frame a game instead).
	header @notgames X-Frame-Options "DENY"

	# Cache media for an hour, but with explicit semantics so response-header
	# changes propagate instead of getting stuck in browsers' heuristic cache
	# (which previously masked the CORP fix and kept videos blocked).
	header /media/* Cache-Control "public, max-age=3600"

	# Proxy everything to the Go backend on the internal compose network.
	reverse_proxy backend:8080

	# Cap request body size to match the backend's MAX_REQUEST_BYTES (64 MiB).
	request_body {
		max_size 64MB
	}

	log {
		output stdout
		format console
	}
}

# Friendly domain for the same API (DNS A record -> this server). Caddy
# auto-provisions a Let's Encrypt cert. The sslip.io host above is kept so
# existing media URLs stored in the DB keep resolving.
ado.404.mn {
	encode zstd gzip

	# See the API_DOMAIN block above: X-Frame-Options is set via a negative
	# matcher so mini-game bundles (/games-static/*) can be framed by our app.
	@notgames not path /games-static/*

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Cross-Origin-Resource-Policy "cross-origin"
		-Server
	}

	header @notgames X-Frame-Options "DENY"

	header /media/* Cache-Control "public, max-age=3600"

	reverse_proxy backend:8080

	request_body {
		max_size 64MB
	}

	log {
		output stdout
		format console
	}
}
