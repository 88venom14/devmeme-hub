HTTP_ADDR=:8080
DATABASE_URL=postgres://devmeme:devmeme@localhost:5432/devmeme_hub?sslmode=disable
# REQUIRED: generate a unique random secret, e.g. `openssl rand -base64 48`.
# The literal placeholder below is rejected at startup — you MUST change it.
JWT_SECRET=change-this-to-at-least-32-characters
ACCESS_TOKEN_TTL=24h
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://fluttershy.horsefucker.ru
MAX_REQUEST_BYTES=67108864
# Per-upload size cap for media (bytes). Defaults to 50 MiB. Clamped to MAX_REQUEST_BYTES.
MAX_UPLOAD_BYTES=52428800
MEDIA_DIR=media
