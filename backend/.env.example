HTTP_ADDR=:8080
DATABASE_URL=postgres://devmeme:devmeme@localhost:5432/devmeme_hub?sslmode=disable
# REQUIRED: generate a unique random secret, e.g. `openssl rand -base64 48`.
# The literal placeholder below is rejected at startup — you MUST change it.
JWT_SECRET=change-this-to-at-least-32-characters
ACCESS_TOKEN_TTL=24h
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://fluttershy.horsefucker.ru
MAX_REQUEST_BYTES=67108864
# Per-upload size cap for media (bytes). Defaults to 50 MiB. Clamped to MAX_REQUEST_BYTES.
MAX_UPLOAD_BYTES=52428800
MEDIA_DIR=media
# Where uploaded mini-game bundles are extracted (one dir per game slug).
GAMES_DIR=games
# Per-upload size cap for a game archive (.zip). Defaults to 25 MiB.
MAX_GAME_UPLOAD_BYTES=26214400

# ── GitHub OAuth login (optional) ──
# Leave CLIENT_ID/SECRET empty to disable GitHub login (OAuthEnabled() == false).
# Get these from the GitHub OAuth App settings. NEVER commit real secrets.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must exactly match the Authorization callback URL registered on the OAuth App.
# Local: http://localhost:8080/api/auth/github/callback
GITHUB_CALLBACK_URL=http://localhost:8080/api/auth/github/callback
# Where the backend redirects the browser after OAuth and in email links.
FRONTEND_URL=http://localhost:5173

# ── Email verification (optional, via Resend) ──
# Verification is only enforced when EMAIL_VERIFICATION=true AND RESEND_API_KEY
# is set. Without a key the backend still runs; new sign-ups are active.
RESEND_API_KEY=
# Sender address; must be on a domain verified in Resend for real delivery.
# resend.dev only delivers to the account owner (fine for a first smoke test).
EMAIL_FROM=DevMeme <onboarding@resend.dev>
EMAIL_VERIFICATION=false
# How long a verification link stays valid.
EMAIL_VERIFY_TTL=24h
